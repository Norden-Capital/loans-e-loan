{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".vercel",
    ".next"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "next": [
        "./lib/compat/next.ts"
      ],
      "next/link": [
        "./lib/compat/link.tsx"
      ],
      "next/image": [
        "./lib/compat/image.tsx"
      ],
      "next/script": [
        "./lib/compat/script.tsx"
      ],
      "next/navigation": [
        "./lib/compat/navigation.ts"
      ],
      "next/og": [
        "./lib/compat/og.tsx"
      ],
      "next/font/google": [
        "./lib/compat/font.ts"
      ],
      "next/dynamic": [
        "./lib/compat/dynamic.ts"
      ]
    },
    "verbatimModuleSyntax": false
  }
}
